<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TeleBridge" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.TeleBridge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8FAFC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TeleBridge</item>
    </style>
</resources>
